+    assert all(x['protected_frame_count'] == 106 and x['poses_bitwise_equal'] for x in evidence['protected_instance_checks'])
+    assert evidence['approval_checks_passed'] is False
+    assert evidence['window_provenance'] == 'algorithm'
+
