# Local secrets and platform deployment state
.env
.env.*
!.env.example
.sites-runtime/
website/.openai/

# Raw mocap sources (re-fetch from the pinned Studio Galt commit)
data/mocap/*/raw/
results/mocap_previews/*.log

# Third-party sign videos and MediaPipe outputs per frame stay local
data/video/*/raw/
data/video/wlasl/WLASL_v0.3.json
results/video_previews/*.log

# Regenerable transition plans, reports, renders, and comparisons stay local
results/mocap_previews/planned_sentence_*.npz
results/mocap_previews/planned_sentence_*.mp4
results/planned_transitions/
results/you_hurt_where_baseline_vs_planned*.mp4

# All-pairs candidate trajectories and per-pair raw evidence remain local.
results/all_pairs/

# Raw pair-run stores stay local (hospital35 alone is ~1.6 GB); only the nine-sentence run is kept (2026-11-01).
results/**/pair_runs/
!results/hospital_sentences_20261101_001/pair_runs/

# New videos stay local (user decision 2026-11-01); videos committed before then remain tracked.
*.mp4
*.webm
*.mov
*.mkv
*.avi
*.m4v
